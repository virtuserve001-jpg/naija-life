# ── All optional. The game runs with zero config. ──

# Port to listen on (Render/Fly/Railway/Heroku set this automatically).
# PORT=3000

# Interface to bind. Keep 0.0.0.0 so the host's proxy can reach you.
# HOST=0.0.0.0

# Where world.json is written. Point at a mounted volume so players
# survive a redeploy (Render Disk, Fly Volume, Railway Volume).
# NAIJA_DATA_DIR=/data

# Only used by `npm run build:static` for a static-only host (Vercel).
# The wss:// URL of your separately-hosted game server.
# NAIJA_WS_URL=wss://naija-life.onrender.com
